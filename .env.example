# Copy this file to .env and paste your key below. .env is git-ignored.
#
# Free key: https://aistudio.google.com/apikey  (Google account, no card needed)
LLM_API_KEY=

# Any OpenAI-compatible provider works; change these two lines to switch.
# Gemini (free tier):
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MODEL=gemini-3.8-flash
# Groq (free tier):  LLM_BASE_URL=https://api.groq.com/openai/v1   LLM_MODEL=openai/gpt-oss-120b
# xAI (paid):  LLM_BASE_URL=https://api.x.ai/v1   LLM_MODEL=grok-4.20-0309-non-reasoning
# OpenRouter (free models end in ":free"):
#   LLM_BASE_URL=https://openrouter.ai/api/v1   LLM_MODEL=nvidia/nemotron-3-super-120b-a12b:free
